#!/usr/bin/env bash
set -uo pipefail

usage() {
  printf 'usage: %s CONFIG COLLECTION_ROOT\n' "${0##*/}" >&2
  exit 2
}

config_error() {
  printf '%s: %s:%d: %s\n' "${0##*/}" "$config" "$line_number" "$1" >&2
  invalid=1
}

[[ $# -eq 2 ]] || usage
config=$1
collection_root=$2

[[ -r $config && -f $config ]] || {
  printf '%s: cannot read config: %s\n' "${0##*/}" "$config" >&2
  exit 2
}
[[ -n $collection_root ]] || usage

declare -a machines=() agents=() hosts=() sources=()
declare -A destinations=()
invalid=0
line_number=0

while IFS= read -r line || [[ -n $line ]]; do
  ((line_number += 1))
  line=${line%$'\r'}
  [[ -z $line || $line == \#* ]] && continue

  without_tabs=${line//$'\t'/}
  if ((${#line} - ${#without_tabs} != 3)); then
    config_error 'expected four tab-separated fields'
    continue
  fi

  IFS=$'\t' read -r machine agent host source <<<"$line"
  if [[ ! $machine =~ ^[A-Za-z0-9._-]+$ ||
    $machine == . || $machine == .. ]]; then
    config_error 'unsafe machine label'
    continue
  fi
  if [[ ! $agent =~ ^[A-Za-z0-9._-]+$ ||
    $agent == . || $agent == .. ]]; then
    config_error 'unsafe agent label'
    continue
  fi
  if [[ $host != - && ! $host =~ ^[A-Za-z0-9_][A-Za-z0-9_.@-]*$ ]]; then
    config_error 'invalid SSH host (use - for a local source)'
    continue
  fi
  # A LOCAL source is a path on this filesystem: it is realpath'd and checked
  # for overlap against the collection root, so it must be absolute.
  #
  # A REMOTE source is interpreted by the remote rsync, and there it may be
  # relative -- indeed it MUST be when the remote key is restricted with
  # `command="rrsync -ro DIR"`, because rrsync resolves every request beneath
  # its own root and an absolute /Users/johnw/.claude becomes
  # /Users/johnw/Users/johnw/.claude. Relative also works for an unrestricted
  # account, resolving against the login home, so it is the portable form.
  if [[ $host == - ]]; then
    if [[ $source != /* || $source == / ]]; then
      config_error 'local source directory must be an absolute path below /'
      continue
    fi
  else
    if [[ -z $source || $source == / ]]; then
      config_error 'remote source directory must not be empty or /'
      continue
    fi
    # Reject traversal outright rather than relying on the remote to catch it.
    if [[ $source == .. || $source == ../* || $source == */../* ||
      $source == */.. ]]; then
      config_error 'remote source directory must not traverse with ..'
      continue
    fi
  fi

  key=$machine/$agent
  if [[ ${destinations[$key]+present} ]]; then
    config_error "duplicate destination: $key"
    continue
  fi
  destinations[$key]=1
  machines+=("$machine")
  agents+=("$agent")
  hosts+=("$host")
  sources+=("$source")
done <"$config"

((invalid == 0)) || exit 2
((${#machines[@]} > 0)) || {
  printf '%s: config contains no sources: %s\n' "${0##*/}" "$config" >&2
  exit 2
}
command -v rsync >/dev/null 2>&1 || {
  printf '%s: rsync is required\n' "${0##*/}" >&2
  exit 2
}
command -v realpath >/dev/null 2>&1 || {
  printf '%s: realpath is required\n' "${0##*/}" >&2
  exit 2
}
collection_root=$(realpath -m -- "$collection_root") || {
  printf '%s: cannot resolve collection root\n' "${0##*/}" >&2
  exit 2
}

for row in "${!machines[@]}"; do
  if [[ ${hosts[$row]} == - ]]; then
    local_source=$(realpath -m -- "${sources[$row]}") || {
      printf '%s: cannot resolve local source: %s\n' \
        "${0##*/}" "${sources[$row]}" >&2
      exit 2
    }
    if [[ $collection_root == "$local_source" ||
      $collection_root == "$local_source/"* ||
      $local_source == "$collection_root/"* ]]; then
      printf '%s: collection root overlaps local source: %s and %s\n' \
        "${0##*/}" "$collection_root" "$local_source" >&2
      exit 2
    fi
  fi
done
for row in "${!machines[@]}"; do
  destination_path=$collection_root/${machines[$row]}/${agents[$row]}
  resolved_destination=$(realpath -m -- "$destination_path") || {
    printf '%s: cannot resolve destination: %s\n' \
      "${0##*/}" "$destination_path" >&2
    exit 2
  }
  if [[ $resolved_destination != "$destination_path" ]]; then
    printf '%s: destination path contains a symlink: %s\n' \
      "${0##*/}" "$destination_path" >&2
    exit 2
  fi
done

mkdir -p -- "$collection_root" || exit 1

failed=0
for row in "${!machines[@]}"; do
  machine=${machines[$row]}
  agent=${agents[$row]}
  host=${hosts[$row]}
  source=${sources[$row]}
  destination=$collection_root/$machine/$agent

  if [[ $host == - && ! -d $source ]]; then
    printf '%s: missing source directory: %s\n' "${0##*/}" "$source" >&2
    failed=1
    continue
  fi
  if ! mkdir -p -- "$destination"; then
    printf '%s: cannot create destination: %s\n' \
      "${0##*/}" "$destination" >&2
    failed=1
    continue
  fi

  printf '%s: gathering %s/%s\n' "${0##*/}" "$machine" "$agent"
  if [[ $host == - ]]; then
    operand=${source%/}/
  else
    operand=$host:${source%/}/
  fi
  # No --protect-args (-s): rrsync disables it unconditionally
  # (short_disabled = 's'), because it changes how arguments reach the server
  # and would let a client slip paths past rrsync's directory check. Any source
  # host whose key is restricted with `command="rrsync -ro DIR"` therefore
  # rejects the whole transfer with "option -s has been disabled on this
  # server". Paths containing spaces still work: rrsync receives the argument
  # intact rather than re-splitting it -- verified against a real
  # "Library/Application Support/..." session root.
  #
  # Never --delete, --delete-excluded, --remove-source-files or --inplace. This
  # collection only ever adds and updates; a file that disappears from a source
  # is deliberately kept. test/gather-sessions.bash asserts both halves: that a
  # vanished source file survives, and that no deleting flag appears in argv.
  # An OFFLINE host is skipped, not failed. Laptops in the fleet travel, and a
  # nightly collection that reports failure every night one of them is away
  # trains its operator to ignore the failure -- at which point a real breakage
  # goes unnoticed too. Only reachability is forgiven: anything else (refused
  # key, missing directory, rrsync rejection, partial transfer) still fails, so
  # a misconfigured host cannot hide behind this.
  #
  # The classification reads rsync's own output rather than probing separately,
  # so it tests the exact transport rsync uses -- including any ProxyJump and
  # per-host identity in RSYNC_RSH. A separate `ssh host true` probe would be
  # wrong here anyway: hosts whose key is restricted with a forced rsync command
  # reject a bare `true` while being perfectly reachable.
  #
  # 2>&1 captures BOTH streams, and the capture is replayed to stderr on a real
  # failure. That costs nothing in practice because no -v or --progress is
  # passed, so rsync is silent on stdout for a successful transfer; there is no
  # streaming output being withheld.
  # NO --checksum, by deliberate decision (2026-08-16). rsync therefore selects
  # files the default way, on size and mtime.
  #
  # It was here to catch the one edit that size+mtime comparison misses: a file
  # rewritten in place with BOTH preserved. Measured cost of keeping it: because
  # --checksum hashes every file on BOTH ends before deciding, the cost does not
  # decay with an unchanged tree. Three consecutive runs took 49m45s, 50m22s and
  # 62m15s, each reading ~125 GB, while the archive grew about 1 GB -- roughly
  # 125 bytes read per byte kept, every night, on vulcan AND on each source,
  # including a VPS reached over the public internet and a laptop that travels.
  #
  # Accepted risk: session transcripts are overwhelmingly append-only, and an
  # append changes size, so the missed case is narrow. It is not zero, and the
  # test suite pins the new behaviour explicitly rather than quietly dropping the
  # old assertion -- see the same-stat case in test/gather-sessions.bash.
  #
  # Symlink permissions: -a implies -p, and rsync 3.5.2 as RECEIVER fails every
  # symlink a macOS sender offers ("failed to set permissions ...: Operation not
  # supported (95)", exit 23), because APFS symlinks carry a mode Linux cannot
  # set. That is fixed in the receiver, not here: vulcan's unit runs the patched
  # rsync-mac-receiver build (RsyncProject/rsync#1148), so -p stays.
  #
  # --exclude=node_modules (2026-11-19): vendored tooling that some agents drag
  # into their config trees is not session data. clio/opencode was 1.6 GB, of
  # which one extension's node_modules was 69 MB, and it is also where nearly all
  # of the offending symlinks live. Excluded at every depth, which is what rsync's
  # bare pattern does.
  if ! rsync_output=$(rsync -a --sparse --exclude=node_modules -- \
    "$operand" "$destination/" 2>&1); then
    # Deliberately NOT matching "Could not resolve hostname": a name that does
    # not resolve is far more likely a typo or a broken config than a machine
    # that is merely away, and silently skipping it would hide the mistake for
    # as long as nobody reads the log. A travelling laptop presents as
    # "No route to host" or a timeout, which is what these patterns catch.
    if printf '%s' "$rsync_output" | grep -qE \
      'No route to host|Connection refused|Connection timed out|Network is unreachable|Operation timed out|Host is down'; then
      printf '%s: skipping %s/%s: host offline\n' \
        "${0##*/}" "$machine" "$agent"
    else
      printf '%s\n' "$rsync_output" >&2
      printf '%s: gather failed: %s/%s\n' \
        "${0##*/}" "$machine" "$agent" >&2
      failed=1
    fi
  fi
done

exit "$failed"
